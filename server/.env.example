PORT=5000
JWT_SECRET=change_this_to_a_long_random_secret

# Supabase (get these from your Supabase project settings)
SUPABASE_URL=https://your-project-ref.supabase.co
# Use either SUPABASE_SERVICE_KEY or SUPABASE_SERVICE_ROLE_KEY (both are accepted)
SUPABASE_SERVICE_KEY=your-service-role-key

# Super admin credentials (seeded automatically on first startup)
SUPER_ADMIN_USERNAME=your_username
SUPER_ADMIN_PIN=your_initial_pin
